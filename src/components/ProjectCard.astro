---
import ProjectPreview from './ProjectPreview.tsx'

interface Props {
  name: string
  status: string
  tagline: string
  badges: string[]
  repoHref: string
  liveHref?: string
  variant: 'compressz' | 'sessionclock' | 'cinematch' | 'compressf'
}
const { name, status, tagline, badges, repoHref, liveHref, variant } = Astro.props
const previewHref = liveHref ?? repoHref
---

<article
  class="group flex flex-col overflow-hidden rounded-2xl border border-line bg-surface transition-all duration-300 hover:-translate-y-1 hover:border-violet/60 hover:shadow-[0_24px_60px_-30px_rgba(139,124,246,0.55)]"
>
  <div class="h-[190px] w-full border-b border-line">
    <ProjectPreview client:visible variant={variant} href={previewHref} label={name} />
  </div>

  <div class="flex flex-1 flex-col p-6">
    <div class="mb-2 flex items-baseline justify-between gap-3">
      <h3 class="font-display text-xl font-bold tracking-tight">{name}</h3>
      <span class="whitespace-nowrap font-mono text-[10px] uppercase tracking-wide text-violet">{status}</span>
    </div>
    <p class="mb-5 text-sm leading-relaxed text-ink-dim">{tagline}</p>
    <div class="mb-5 flex flex-wrap gap-2">
      {
        badges.map((b) => (
          <span class="rounded-md border border-line bg-surface-2 px-2.5 py-1 font-mono text-[11px] text-ink-dim">
            {b}
          </span>
        ))
      }
    </div>
    <div class="mt-auto flex flex-wrap gap-3">
      <a
        href={repoHref}
        target="_blank"
        rel="noopener"
        class="flex items-center gap-2 rounded-lg border border-line px-3.5 py-2 font-mono text-xs transition-all hover:-translate-y-0.5 hover:border-violet"
      >
        <svg viewBox="0 0 16 16" width="13" height="13" fill="currentColor">
          <path
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"
          ></path>
        </svg>
        Repository
      </a>
      {
        liveHref && (
          <a
            href={liveHref}
            target="_blank"
            rel="noopener"
            class="flex items-center gap-2 rounded-lg border border-line px-3.5 py-2 font-mono text-xs transition-all hover:-translate-y-0.5 hover:border-violet"
          >
            Live preview ↗
          </a>
        )
      }
    </div>
  </div>
</article>
